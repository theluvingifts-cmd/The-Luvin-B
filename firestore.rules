
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in to Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // RULES FOR ORDERS
    match /orders/{orderId} {
      allow read: if true; // Public read for tracking (could be stricter)
      allow create: if true; // Public create
      allow update: if true; // Public update (needed for customer self-service logic currently)
      allow delete: if isAuthenticated(); // Only staff can delete
    }

    // RULES FOR PRODUCTS (Inventory)
    match /lego_parts/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Only staff can manage products
    }

    // RULES FOR FRAMES
    match /frames/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // OTHER COLLECTIONS
    match /backgrounds/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /templates/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /feedbacks/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Important: Protect config
    }
    
    match /vouchers/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /assets/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /analytics/{document=**} {
      allow read: if true; 
      allow write: if true; 
    }
    
    // NEW: Logs
    match /system_logs/{document=**} {
      allow read: if isAuthenticated();
      allow create: if true; // Public create (e.g. system logs from client actions)
      allow update, delete: if false; // Logs are immutable
    }
  }
}
