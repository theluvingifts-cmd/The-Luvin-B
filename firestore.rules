
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'jinbduong@gmail.com' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }
    
    function isStaff() {
      return request.auth != null;
    }

    // RULES FOR ORDERS
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      
      // Allow customers to update their own orders (e.g. status, items, address)
      // Since we don't have customer auth, we allow public updates for now based on Order ID knowledge.
      allow update: if true; 
      
      allow delete: if isAdmin();
    }

    // RULES FOR PRODUCTS (Inventory)
    match /lego_parts/{document=**} {
      allow read: if true;
      
      // Allow admin to do anything
      allow create, delete: if isAdmin();
      
      // Allow public to update ONLY the 'stock' field (for inventory adjustment)
      // OR allow admin to update everything
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // RULES FOR FRAMES (Inventory)
    match /frames/{document=**} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // OTHER COLLECTIONS (Admin Only Write)
    match /backgrounds/{document=**} {
      allow read: if true;
      // Explicitly allow write for admin to save background templates with overlayConfig
      allow write: if isAdmin();
    }

    match /templates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedbacks/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /vouchers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
