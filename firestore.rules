
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && 
             request.auth.token.get('email', '') != '' && (
        request.auth.token.email.matches('(?i)jinbduong@gmail\\.com') ||
        request.auth.token.email.matches('(?i)theluvin\\.gifts@gmail\\.com') ||
        request.auth.token.email.matches('(?i)theluvingifts@gmail\\.com') ||
        (request.auth.token.email.matches('(?i).*admin.*') && request.auth.token.get('email_verified', false) == true)
      );
    }

    function isSuperAdmin() {
      return isVerifiedAdmin() && (
        request.auth.token.get('email', '').matches('(?i)theluvin\\.gifts@gmail\\.com') ||
        request.auth.token.get('email', '').matches('(?i)jinbduong@gmail\\.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidLegoPart(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'imageUrl']) &&
             data.id is string && data.id.size() <= 50 &&
             data.name is string && data.name.size() <= 200 &&
             data.type is string && data.type.size() <= 50 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             (!('stock' in data) || data.stock is number) &&
             (!('gender' in data) || data.gender in ['male', 'female', 'unisex']);
    }

    // --- Collection Rules ---

    // 1. LEGO PARTS
    match /lego_parts/{partId} {
      allow get: if true;
      allow list: if true; // Public catalog
      allow create, delete: if isVerifiedAdmin() && isValidId(partId);
      
      allow update: if (
        isVerifiedAdmin() ||
        // Action: Stock Adjustment (Public/Checkout)
        (incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'lastUpdated']) && incoming().stock is number)
      ) && (isVerifiedAdmin() || isValidLegoPart(incoming()));
    }

    // 2. ORDERS
    match /orders/{orderId} {
      allow get: if true; // Allow customer to see their order if they have the ID
      allow list: if isVerifiedAdmin() || (request.query.limit <= 20); // Searchable by phone (Firestore handles the data-level phone constraint if queried correctly)
      allow create: if true; // Guest order
      allow update: if isVerifiedAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentProofUrl', 'paymentProofUploadedAt'])
      ) || (
        // Auto-cancel logic (Expired orders)
        incoming().status == 'Đã hủy' && 
        existing().status == 'Chờ thanh toán' &&
        request.time.toMillis() >= (existing().createdAt + (48 * 60 * 60 * 1000)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt', 'internalNotes'])
      );
      allow delete: if isVerifiedAdmin();
    }

    // 3. ANALYTICS
    match /analytics/{docId} {
      allow read: if isVerifiedAdmin();
      allow write: if true; // Guest funnel tracking
    }

    // 4. SHARED DESIGNS
    match /shared_designs/{designId} {
      allow get: if true;
      allow list: if isVerifiedAdmin();
      allow create: if true;
      allow update, delete: if isVerifiedAdmin();
    }

    // 5. COLLABORATORS (CTVs)
    match /collaborators/{uid} {
      allow get: if true; 
      allow list: if isVerifiedAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if (isSignedIn() && request.auth.uid == uid) || isVerifiedAdmin();
      allow delete: if isVerifiedAdmin();
    }

    // 6. CTV DESIGNS
    match /ctv_designs/{designId} {
      allow get: if true;
      allow list: if isSignedIn() && request.auth.uid == resource.data.ctvUid;
      allow create: if isSignedIn() && incoming().ctvUid == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().ctvUid == request.auth.uid;
    }

    // 7. ASSETS, CONFIG, VOUCHERS, BACKGROUNDS, TEMPLATES
    match /backgrounds/{docId} { allow read: if true; allow write: if isVerifiedAdmin(); }
    match /templates/{docId} { 
      allow read: if true; 
      allow create, delete: if isVerifiedAdmin();
      allow update: if isVerifiedAdmin() || (incoming().diff(existing()).affectedKeys().hasAny(['purchaseCount', 'orders', 'stock']));
    }
    match /config/{docId} { 
      allow read: if true; 
      allow write: if isVerifiedAdmin() || (docId == 'stats'); 
      match /ads_costs/{date} {
        allow read, write: if isVerifiedAdmin();
      }
    }
    match /vouchers/{docId} { 
      allow get: if true; // Allow guests to validate vouchers
      allow list: if isVerifiedAdmin(); 
      allow update: if isVerifiedAdmin() || (incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'usedBy']));
      allow write: if isVerifiedAdmin(); 
    }
    match /assets/{docId} { allow read: if true; allow write: if isVerifiedAdmin(); }
    match /frames/{docId} { allow read: if true; allow write: if isVerifiedAdmin(); }
    match /feedbacks/{docId} { allow read: if true; allow write: if isVerifiedAdmin(); }

    // 8. AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isVerifiedAdmin();
    }

    // 9. ADMIN SESSIONS
    match /admin_sessions/{sessionId} {
      allow get: if isVerifiedAdmin();
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAdmin() && incoming().uid == request.auth.uid;
      allow update: if isVerifiedAdmin() && (
        (isSignedIn() && request.auth.uid == existing().uid && !incoming().isRevoked) || 
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }
  }
}
