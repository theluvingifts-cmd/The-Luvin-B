{
  "entities": {
    "SharedDesign": {
      "title": "SharedDesign",
      "description": "A design shared by a user to be loaded by others.",
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "description": "The FrameConfig object representing the design."
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when the design was shared."
        },
        "createdBy": {
          "type": "string",
          "description": "Referral ID or phone of the person who shared it."
        }
      },
      "required": ["config", "createdAt"]
    },
    "Collaborator": {
      "title": "Collaborator",
      "description": "A collaborator (CTV) who refers customers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "fullName": { "type": "string" },
        "referralCode": { "type": "string", "description": "Unique code for links." },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "referralCode"]
    },
    "CTVDesign": {
      "title": "CTVDesign",
      "description": "A design saved by a CTV for their own use and sharing.",
      "type": "object",
      "properties": {
        "ctvUid": { "type": "string", "description": "UID of the CTV who saved it." },
        "name": { "type": "string", "description": "Name of the design." },
        "config": { "type": "object", "description": "The FrameConfig object." },
        "createdAt": { "type": "number" }
      },
      "required": ["ctvUid", "name", "config", "createdAt"]
    },
    "Template": {
      "title": "Template",
      "description": "A purchasable product template.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "price": { "type": "number" },
        "config": { "type": "object" },
        "purchaseCount": { "type": "number" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "imageUrl", "config"]
    },
    "Background": {
      "title": "Background",
      "description": "A preset background for the studio.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["square", "rectangle"] },
        "imageUrl": { "type": "string" },
        "url": { "type": "string" },
        "config": { "type": "object" },
        "formFields": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "url"]
    }
  },
  "firestore": {
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Collection of product templates."
    },
    "/backgrounds/{backgroundId}": {
      "schema": "Background",
      "description": "Collection of preset backgrounds."
    },
    "/shared_designs/{designId}": {
      "schema": "SharedDesign",
      "description": "Collection of shared designs."
    },
    "/collaborators/{uid}": {
      "schema": "Collaborator",
      "description": "Collection of collaborator profiles."
    },
    "/ctv_designs/{designId}": {
      "schema": "CTVDesign",
      "description": "Collection of designs saved by CTVs."
    }
  }
}
